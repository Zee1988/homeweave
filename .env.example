# Backend runtime only. Never put Home Assistant tokens or model keys in EXPO_PUBLIC_*.
NODE_ENV=development
# The API reads PORT (apps/api/src/config/app-config.ts, DEFAULT_PORT=8099); the old prefixed
# name had no consumer anywhere in the repo. 8099 is the port HA's ingress_port and the app
# watchdog both target -- changing one without the others points Supervisor at a dead socket.
PORT=8099
APP_BASE_URL=http://localhost:8099
SESSION_SECRET=replace-with-long-random-secret
APP_ENCRYPTION_KEY=replace-with-supported-key-format
# SQLite database file (Prisma 7 reads this in apps/api/prisma.config.ts).
# Local dev default: relative path under the gitignored data/ directory.
# Home Assistant App container: absolute path on the persistent volume ->
#   DATABASE_URL=file:/data/homeweave.db
# Throwaway DB for local verification (gitignored .tmp/):
#   DATABASE_URL=file:.tmp/dev.db
# Never point this at a real HA backup; never commit a .db file.
# The production image already sets the container value (Dockerfile ENV), so HAOS needs no override.
DATABASE_URL=file:./data/app.db
# Optional floor for free space on the data directory, default 10 MiB. Below it the app still
# boots, logs startup_disk_low and /health/ready answers 503. A malformed value falls back to
# the default rather than failing the boot (apps/api/src/health/checks/disk.check.ts).
# DISK_MIN_FREE_BYTES=10485760
HA_CONNECT_TIMEOUT_MS=5000
HA_REQUEST_TIMEOUT_MS=10000
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
LOG_LEVEL=info
ALLOW_INSECURE_LOCAL_HTTP=true
# Optional, only if push notifications are enabled. Provider secrets remain backend-only.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
