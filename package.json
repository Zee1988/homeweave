{
  "name": "homeweave",
  "version": "0.1.0",
  "private": true,
  "description": "HomeWeave - AI Home Operating System for Home Assistant",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "generate:app": "node scripts/generate-app-metadata.mjs",
    "validate:app": "node scripts/validate-app-metadata.mjs",
    "check:app": "node scripts/generate-app-metadata.mjs --check",
    "test:app": "node scripts/generate-app-metadata.mjs --check && node --test \"scripts/**/*.test.mjs\"",
    "probe:prisma-engine": "node scripts/probe-prisma-engine.mjs",
    "validate:dockerfile": "node scripts/validate-dockerfile.mjs",
    "validate:workflows": "node scripts/validate-workflows.mjs --profile all",
    "validate:workflows:ci": "node scripts/validate-workflows.mjs --profile ci",
    "validate:workflows:release": "node scripts/validate-workflows.mjs --profile release",
    "build:image": "node scripts/build-image.mjs",
    "lint": "node scripts/validate-workflows.mjs --profile all && node scripts/validate-dockerfile.mjs && node scripts/lint-workspace.mjs",
    "typecheck": "node scripts/typecheck-workspace.mjs",
    "test": "corepack pnpm@9.15.4 run test:app && corepack pnpm@9.15.4 -r --if-present test"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "^13.0.3"
    }
  }
}
