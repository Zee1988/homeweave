{
  "name": "@homeweave/api",
  "version": "0.0.0",
  "private": true,
  "description": "HomeWeave API. This version is independent of the HA App version in homeweave_app/config.yaml and never feeds the image tag.",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\" && node --test \"test/**/*.dist.test.mjs\"",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.0",
    "@nestjs/core": "^12.3.0",
    "@nestjs/platform-express": "^12.3.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "^13.0.3",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
